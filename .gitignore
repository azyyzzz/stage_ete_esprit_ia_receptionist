.venv/
__pycache__/
*.pyc

# Base vectorielle ChromaDB : regeneree via `python -m modules.rag.ingest`,
# ne doit pas etre versionnee (fichiers binaires, potentiellement volumineux).
vector_store/

# Modeles de voix Piper (TTS) : re-telechargeables via
# `python -m piper.download_voices <voix> --download-dir voice_models`,
# ne doivent pas etre versionnes (fichiers binaires volumineux).
voice_models/

# Fichiers auxiliaires de compilation LaTeX (rapport/) : regenerees a
# chaque compilation, seul le .tex (source) et le .pdf (livrable) comptent.
rapport/*.aux
rapport/*.log
rapport/*.out
rapport/*.toc

# extraction_app : fichiers uploades temporaires, identifiants locaux (mot
# de passe hashe genere au premier lancement) et journaux d'execution
# (historique/registre des URLs, propres a chaque environnement) -- jamais
# versionnes.
extraction_app/uploads/*
!extraction_app/uploads/.gitkeep
extraction_app/data/config_local.json
extraction_app/data/historique.json
extraction_app/data/url_sources.json
extraction_app/data/a_verifier.json
